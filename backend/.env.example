# ==============================================================================
# SMART SCHOLARSHIP ELIGIBILITY SYSTEM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# MongoDB Configuration
URL_MONGODB=mongodb://localhost:27017
NOM_BASE_DONNEES=admission_intelligente

# FastAPI API Configuration
ENVIRONNEMENT_FASTAPI=developpement
PORT_API=8000
HOTE_API=0.0.0.0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
NIVEAU_JOURNAL=INFO

# Administrator Credentials (required to enable admin login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# JWT Signing Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Additional CORS Origins (comma-separated)
CORS_ORIGINES_SUPPLEMENTAIRES=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
