# ==============================================================================
# SMART SCHOLARSHIP ELIGIBILITY SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# MONGODB CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection URI:
# - For local host execution: mongodb://localhost:27017
# - For Docker Compose: mongodb://mongodb:27017
URL_MONGODB=mongodb://localhost:27017
NOM_BASE_DONNEES=admission_intelligente
MONGO_PORT=27017

# ------------------------------------------------------------------------------
# FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
HOTE_API=0.0.0.0
PORT_API=8000
ENVIRONNEMENT_FASTAPI=developpement
NIVEAU_JOURNAL=INFO

# ------------------------------------------------------------------------------
# ADMIN CREDENTIALS & SECURITY
# ------------------------------------------------------------------------------
# Required for administrator login portal:
ADMIN_EMAIL=admin@admission.ma
ADMIN_PASSWORD=change-me-please
# 64-character hex secret for signing JWT tokens.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ------------------------------------------------------------------------------
# CORS & FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Additional comma-separated allowed origins for CORS
CORS_ORIGINES_SUPPLEMENTAIRES=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
# Base URL for frontend API requests
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
# Host port for the React application container
FRONTEND_PORT=3000
